[Unit]
Description=Telegram Music Bot Service
After=network.target

[Service]
Type=simple
User=root
# Loyiha joylashgan katalog (o'zingiznikiga moslang):
WorkingDirectory=/root/akobir
# Virtual muhit yoki tizim python yo'li:
ExecStart=/root/akobir/venv/bin/python main.py
Restart=always
RestartSec=10
EnvironmentFile=/root/akobir/.env

# Resurs cheklovlari
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
